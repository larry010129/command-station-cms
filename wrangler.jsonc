{
  "name": "command-station-cms",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "command-station",
      "database_id": "1dcff2e4-a47e-4a4b-84ed-3a2749484477",
      "migrations_dir": "migrations"
    }
  ],
  // Filled in after Cloudflare Access is created. Empty means every /api call is refused (401).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ALLOWED_EMAILS": "",
    "PUBLIC_KEY": ""
  }
}
