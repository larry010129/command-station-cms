{
  "name": "command-station-cms",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "command-station",
      "database_id": "1dcff2e4-a47e-4a4b-84ed-3a2749484477",
      "migrations_dir": "migrations"
    }
  ],
  // Dashboard-set variables (ACCESS_TEAM_DOMAIN, ACCESS_AUD, ALLOWED_EMAILS) and the SIGNING_KEY secret survive deploys.
  "keep_vars": true,
  "vars": {
    "PUBLIC_KEY": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAan8+LuhMQE917GeaCqJisDHujxEMg7KDXtsufefwP4g=\n-----END PUBLIC KEY-----"
  }
}
