{
  "name": "command-station-cms",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "command-station",
      "database_id": "1dcff2e4-a47e-4a4b-84ed-3a2749484477",
      "migrations_dir": "migrations"
    }
  ],
  // The SIGNING_KEY secret and any extra dashboard variables (e.g. ALLOWED_EMAILS) survive deploys.
  "keep_vars": true,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "lucky-wind-19c4.cloudflareaccess.com",
    "ACCESS_AUD": "284ca174fe6c45af4aa0eaf6af07090263b0a0d3aeb8e3d7ca2df4780fe904b1",
    "PUBLIC_KEY": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAan8+LuhMQE917GeaCqJisDHujxEMg7KDXtsufefwP4g=\n-----END PUBLIC KEY-----"
  }
}
